# Backend
# connection_limit caps Prisma's pool so concurrent load doesn't exhaust
# available DB connections (Section 4D) - tune to your DB plan's max
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DBNAME?connection_limit=10
# Required in production. Local development/tests may omit it to use the
# in-memory fallback.
REDIS_URL=redis://USER:PASSWORD@HOST:PORT
# Required in production. Comma-separated browser origins allowed to call
# the HTTP API and Socket.IO. Local development/tests may omit it.
CORS_ORIGINS=https://admin.example.com,https://staging-admin.example.com
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_TOTP_SECRET=
ARKESEL_API_KEY=
CLOUDINARY_URL=
GOOGLE_MAPS_API_KEY=
# Push notifications use Expo's push service (driver app), not raw FCM -
# no server-side key needed for that. Sentry DSN below is optional; error
# tracking is skipped entirely if unset.
SENTRY_DSN=

# Mobile apps
API_BASE_URL=https://api.example.com
SOCKET_URL=https://api.example.com
MOBILE_GOOGLE_MAPS_API_KEY=

# Admin web (Vite). Include /api/v1 because the admin appends route
# paths such as /auth/... and /admin/... to this value.
VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_MAPS_API_KEY=

# Mobile Google Maps SDK configuration
CUSTOMER_GOOGLE_MAPS_ANDROID_API_KEY=your_customer_android_maps_key
CUSTOMER_GOOGLE_MAPS_IOS_API_KEY=your_customer_ios_maps_key
DRIVER_GOOGLE_MAPS_ANDROID_API_KEY=your_driver_android_maps_key
DRIVER_GOOGLE_MAPS_IOS_API_KEY=your_driver_ios_maps_key
