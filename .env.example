# Backend
# connection_limit caps Prisma's pool so concurrent load doesn't exhaust
# available DB connections (Section 4D) - tune to your DB plan's max
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DBNAME?connection_limit=10
REDIS_URL=redis://USER:PASSWORD@HOST:PORT
JWT_SECRET=change-me
ARKESEL_API_KEY=
CLOUDINARY_URL=
GOOGLE_MAPS_API_KEY=
# Push notifications use Expo's push service (driver app), not raw FCM -
# no server-side key needed for that. Sentry DSN below is optional; error
# tracking is skipped entirely if unset.
SENTRY_DSN=

# Mobile apps
API_BASE_URL=https://api.example.com
SOCKET_URL=https://api.example.com
MOBILE_GOOGLE_MAPS_API_KEY=

# Admin web (Vite)
VITE_API_BASE_URL=https://api.example.com
VITE_SOCKET_URL=https://api.example.com
VITE_MAPS_API_KEY=
